{
  "manifest_version": 3,
  "name": "mlops",
  "version": "0.1.0",
  "permissions": ["alarms", "storage", "scripting", "tabs", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
"action": {
    "default_title": "MLOps",
    "default_popup": "popup.html"
  }
}
