{
  "manifest_version": 3,
  "name": "mlops",
  "version": "0.1.0",
  "permissions": ["alarms", "storage", "scripting", "tabs, nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MLOps",
    "default_popup": "popup.html"
  }
}
