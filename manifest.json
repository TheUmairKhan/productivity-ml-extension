{
  "manifest_version": 3,
  "name": "mlops",
  "version": "0.1.0",
  "key": "",
  "permissions": ["alarms", "storage", "scripting", "tabs", "nativeMessaging", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MLOps",
    "default_popup": "popup.html"
  },
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}
