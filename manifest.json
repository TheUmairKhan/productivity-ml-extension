{
  "manifest_version": 3,
  "name": "mlops",
  "version": "0.1.0",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
