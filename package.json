{
  "name": "mlops",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "assets": "python models/export_onnx.py && python models/export_client_assets.py",
    "build": "rm -rf dist && node scripts/build.mjs",
